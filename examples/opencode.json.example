{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "hy3local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hy3 Local",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:HY3_API_KEY}",
        "includeUsage": true
      },
      "models": {
        "hy3": {
          "name": "Hy3",
          "limit": { "context": 131072, "output": 8192 }
        },
        "hy3-think": {
          "name": "Hy3 Think",
          "limit": { "context": 131072, "output": 8192 }
        }
      }
    }
  }
}
