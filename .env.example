# hy3-openai-api environment configuration template.
# Copy to .env (or export in your shell) and edit values before going live.

# ---- Network ----
HOST=0.0.0.0
PORT=8000
PYTHONUNBUFFERED=1

# ---- Upstream Hy3 ----
# The HuggingFace Gradio endpoint. Change if hosting a different Hy3 instance.
HY3_BASE=https://tencent-Hy3.hf.space/gradio_api/call/chat
# Read timeout for upstream calls (seconds). Default 90 fits Render's ~100s
# gateway. Set to 300 on platforms without a gateway timeout (Fly, Cloud Run).
HTTP_READ_TIMEOUT=90
# Whether Hy3 includes reasoning text in the response (exposed as
# reasoning_content). Set to false to reduce latency and token counts.
PRESERVED_THINKING=true

# ---- Concurrency ----
MAX_CONCURRENT=10
QUEUE_TIMEOUT=5

# ---- Security (REQUIRED for any public deployment) ----
# Comma-separated API keys. If set, /v1/chat/completions requires a Bearer token.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Secret token for /admin/* endpoints. If unset, admin endpoints return 404.
ADMIN_TOKEN=
# Allowed CORS origin(s). "*" (default) = no credentials. Set to a specific
# origin (or comma-separated list) to enable credentialed CORS.
ADMIN_ORIGIN=*
# Trust X-Forwarded-For / X-Real-IP headers. Default true (every documented
# platform puts a proxy in front). Set to false if exposing directly.
TRUST_PROXY_HEADERS=true

# ---- DoS protection ----
MAX_MESSAGES=1000
MAX_CONTENT_CHARS=1000000
MAX_BODY_BYTES=8000000
SSE_BUFFER_CAP=10000000
# v1.5.4 (Fix 2): cap on reasoning_content length in chars. The hy3-think
# model can produce 100KB+ of reasoning in a single response, causing 80-104s
# generation times, gateway timeouts, and overwhelmed client tools. This cap
# truncates reasoning and appends a truncation indicator. Set to 0 to disable.
# Applied to both /v1/chat/completions and /v1/responses, in both streaming
# and non-streaming paths.
MAX_REASONING_CHARS=50000

# ---- Logging ----
LOG_LEVEL=INFO
